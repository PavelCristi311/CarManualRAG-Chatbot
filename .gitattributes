# Large runtime artifacts must be stored through Git LFS. The GGUF model alone
# exceeds GitHub's 100 MiB per-file limit.
*.aar filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text

# Keep text files consistent across development platforms.
*.gradle text eol=lf
*.java text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
gradlew text eol=lf
